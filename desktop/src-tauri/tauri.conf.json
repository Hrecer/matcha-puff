{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "抹茶泡芙",
  "version": "0.1.1",
  "identifier": "com.matchapuff.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}