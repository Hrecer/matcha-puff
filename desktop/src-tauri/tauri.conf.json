{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "抹茶泡芙",
  "version": "0.1.5",
  "identifier": "com.matchapuff.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "抹茶泡芙",
    "copyright": "Copyright © 2026 抹茶泡芙",
    "category": "Productivity",
    "shortDescription": "抹茶泡芙 · 桌面效率工具平台",
    "longDescription": "专注、时间、白噪音与 53 个内置工具，数据都留在本机。",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis/header.bmp",
        "uninstallerHeaderImage": "icons/nsis/header.bmp",
        "sidebarImage": "icons/nsis/sidebar.bmp",
        "installMode": "both",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}